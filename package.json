{
  "name": "dex-claude-plugin",
  "version": "2026.2.7",
  "description": "Runs jobs in Claude on a schedule",
  "type": "module",
  "bin": {
    "dex-claude-plugin": "bin/dex-claude.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node bin/dex-claude.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "release": "npm version patch && git push && git push --tags && npm publish",
    "release:minor": "npm version minor && git push && git push --tags && npm publish",
    "release:major": "npm version major && git push && git push --tags && npm publish"
  },
  "keywords": [
    "claude",
    "claude-code",
    "plugin",
    "mcp",
    "scheduling",
    "cron",
    "automation",
    "jobs"
  ],
  "author": "Fingerskier",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerskier/dex-claude-plugin.git"
  },
  "homepage": "https://github.com/fingerskier/dex-claude-plugin#readme",
  "bugs": {
    "url": "https://github.com/fingerskier/dex-claude-plugin/issues"
  },
  "files": [
    "dist/",
    "bin/",
    ".claude-plugin/",
    ".mcp.json",
    "mcp-servers.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cron-parser": "^4.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
